{
  "name": "@xamfoo/pi-openrouter-pin",
  "version": "0.0.1-rc.2",
  "description": "Pi extension to pin an OpenRouter model to a provider.",
  "type": "module",
  "keywords": [
    "pi-package",
    "openrouter",
    "routing",
    "pi"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xamfoo/pi-openrouter-pin.git"
  },
  "author": "pi-openrouter-pin contributors",
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@types/node": "^24.0.0"
  },
  "scripts": {
    "prepublishOnly": "npm run typecheck && npm test",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test \"test/*.test.ts\""
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ]
}
